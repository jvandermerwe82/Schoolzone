# Copy to .env (never commit real secrets). All optional except where noted.
PORT=8787
DATABASE_PATH=schoolzone.db
# Set to production when deployed behind HTTPS (turns on Secure cookies and serves dist/).
NODE_ENV=development

# AI tutor: switched on only when an Anthropic API key is present.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
# low | medium | high: how much the model thinks before replying.
TUTOR_EFFORT=medium
TUTOR_DAILY_LIMIT=60
TUTOR_ENABLED=true

# Research export of pseudonymised answer data (only for parents who opted in).
ADMIN_TOKEN=
EXPORT_SALT=
# Answer events and tutor chats older than this are deleted.
RETENTION_DAYS=365
