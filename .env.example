# Copy to .env (never commit real secrets). All optional except where noted.
PORT=8787
DATABASE_PATH=schoolzone.db
# Set to production when deployed behind HTTPS (turns on Secure cookies and serves dist/).
NODE_ENV=development

# Public address of the app, used in email links (e.g. https://schoolzone.example.org).
APP_URL=http://localhost:5173

# Email (verification, password reset, safety alerts). Any SMTP provider works, e.g.
# smtps://USER:PASSWORD@smtp.example.com:465 . Without it, emails are only printed to the log.
SMTP_URL=
MAIL_FROM=Schoolzone <no-reply@example.org>

# AI tutor: switched on only when an Anthropic API key is present.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
# low | medium | high: how much the model thinks before replying.
TUTOR_EFFORT=medium
TUTOR_DAILY_LIMIT=60
TUTOR_ENABLED=true

# Research export of pseudonymised answer data (only for parents who opted in).
ADMIN_TOKEN=
# Gets an email when a teacher registers a school, so you can check and approve it.
ADMIN_EMAIL=
EXPORT_SALT=
# Behind a hosting proxy / load balancer (most hosts): true, or the proxy's addresses (comma-separated).
# Only set this if the app can't be reached except through that proxy.
TRUST_PROXY=

# Daily backups (kept for BACKUP_KEEP days). Backups contain children's data: keep them encrypted.
BACKUP_DIR=backups
BACKUP_KEEP=14

# Answer events and tutor chats older than this are deleted.
RETENTION_DAYS=365
