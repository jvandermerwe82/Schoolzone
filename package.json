{
  "name": "schoolzone",
  "version": "1.0.0",
  "description": "Schoolzone: adaptive extra classes for kids (maths, science) with a learner model that adapts to each child.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "brain:lab": "tsx scripts/brain-lab.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "preview:scripted-tutor": "vite build && tsx server/dev-fake-tutor.ts",
    "backup": "tsx --env-file-if-exists=.env server/backup-now.ts",
    "content:export": "tsx scripts/export-content.ts",
    "check:email": "tsx --env-file-if-exists=.env scripts/check-email.ts",
    "check:tutor": "tsx --env-file-if-exists=.env scripts/check-tutor.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvandermerwe82/Schoolzone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jvandermerwe82/Schoolzone/issues"
  },
  "homepage": "https://github.com/jvandermerwe82/Schoolzone#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10"
  }
}
